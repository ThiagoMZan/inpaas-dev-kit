{
  "name": "inpaas-source-tools",
  "displayName": "inPaaS Studio Tools",
  "description": "Integração local do VS Code com sources, forms e entities existentes na plataforma inPaaS.",
  "version": "0.6.80",
  "publisher": "inpaas-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:inpaas.downloadSource",
    "onCommand:inpaas.downloadForm",
    "onCommand:inpaas.downloadEntity",
    "onCommand:inpaas.createEntity",
    "onCommand:inpaas.openEntityEditor",
    "onCommand:inpaas.openFormEditor",
    "onCommand:inpaas.openSourceEditor",
    "onCommand:inpaas.openSearch",
    "onCommand:inpaas.createApplication",
    "onCommand:inpaas.createModule",
    "onCommand:inpaas.openRelease",
    "onCommand:inpaas.openLabels",
    "onCommand:inpaas.openPermissions",
    "onCommand:inpaas.openMenus",
    "onCommand:inpaas.openBusinessProperties",
    "onCommand:inpaas.openModuleSettings",
    "onCommand:inpaas.downloadModule",
    "onCommand:inpaas.publishEntity",
    "onCommand:inpaas.downloadSourceResource",
    "onCommand:inpaas.publishSourceResource",
    "onCommand:inpaas.downloadFormResource",
    "onCommand:inpaas.publishFormResource",
    "onCommand:inpaas.copyKey",
    "onCommand:inpaas.downloadOrUpdateResource",
    "onCommand:inpaas.publishResource",
    "onCommand:inpaas.newQuery",
    "onCommand:inpaas.executeQuery",
    "onCommand:inpaas.formatSql",
    "onCommand:inpaas.refreshDatabaseMetadata",
    "onCommand:inpaas.openStudio",
    "onCommand:inpaas.selectModule",
    "onCommand:inpaas.createForm",
    "onCommand:inpaas.createSource",
    "onCommand:inpaas.openIncludedForm",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:sql"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inpaas.downloadSource",
        "title": "inPaaS: Download Source",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.downloadForm",
        "title": "Baixar form",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.downloadEntity",
        "title": "inPaaS: Download Entity",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.createEntity",
        "title": "inPaaS: New Entity",
        "category": "inPaaS",
        "icon": "$(new-file)"
      },
      {
        "command": "inpaas.openEntityEditor",
        "title": "inPaaS: Open Entity Editor",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.openFormEditor",
        "title": "inPaaS: Open Form Editor"
      },
      {
        "command": "inpaas.openSourceEditor",
        "title": "inPaaS: Open Source Editor"
      },
      {
        "command": "inpaas.publishEntity",
        "title": "inPaaS: Publish Entity",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.downloadSourceResource",
        "title": "inPaaS: Download Source"
      },
      {
        "command": "inpaas.publishSourceResource",
        "title": "inPaaS: Publish Source"
      },
      {
        "command": "inpaas.downloadFormResource",
        "title": "inPaaS: Download Form"
      },
      {
        "command": "inpaas.publishFormResource",
        "title": "inPaaS: Publish Form"
      },
      {
        "command": "inpaas.copyKey",
        "title": "inPaaS: Copy Key"
      },
      {
        "command": "inpaas.downloadOrUpdateResource",
        "title": "inPaaS: Download"
      },
      {
        "command": "inpaas.publishResource",
        "title": "inPaaS: Publish"
      },
      {
        "command": "inpaas.newQuery",
        "title": "Nova query",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.executeQuery",
        "title": "Executar query",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.formatSql",
        "title": "Formatar SQL",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.refreshDatabaseMetadata",
        "title": "Atualizar metadados do banco",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.openStudio",
        "title": "Studio",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.openSearch",
        "title": "inPaaS: Search",
        "category": "inPaaS",
        "icon": "$(search)"
      },
      {
        "command": "inpaas.createApplication",
        "title": "inPaaS: New Application",
        "category": "inPaaS",
        "icon": "$(new-file)"
      },
      {
        "command": "inpaas.createModule",
        "title": "inPaaS: New Module",
        "category": "inPaaS",
        "icon": "$(new-file)"
      },
      {
        "command": "inpaas.openRelease",
        "title": "inPaaS: New Release",
        "category": "inPaaS",
        "icon": "$(rocket)"
      },
      {
        "command": "inpaas.openLabels",
        "title": "inPaaS: Labels",
        "category": "inPaaS",
        "icon": "$(tag)"
      },
      {
        "command": "inpaas.openPermissions",
        "title": "inPaaS: Permissions",
        "category": "inPaaS",
        "icon": "$(lock)"
      },
      {
        "command": "inpaas.openMenus",
        "title": "inPaaS: Menus",
        "category": "inPaaS",
        "icon": "$(list-tree)"
      },
      {
        "command": "inpaas.openBusinessProperties",
        "title": "inPaaS: Business Properties",
        "category": "inPaaS",
        "icon": "$(symbol-property)"
      },
      {
        "command": "inpaas.openModuleSettings",
        "title": "inPaaS: Module Settings",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.downloadModule",
        "title": "inPaaS: Download Module",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.selectModule",
        "title": "Selecionar módulo",
        "category": "inPaaS"
      },
      {
        "command": "inpaas.createForm",
        "title": "inPaaS: New Form",
        "category": "inPaaS",
        "icon": "$(new-file)"
      },
      {
        "command": "inpaas.createSource",
        "title": "inPaaS: New Source",
        "category": "inPaaS",
        "icon": "$(new-file)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inpaas",
          "title": "inPaaS",
          "icon": "media/inpaas.svg"
        }
      ]
    },
    "views": {
      "inpaas": [
        {
          "id": "inpaas.moduleContext",
          "name": "Module",
          "icon": "media/inpaas.svg"
        },
        {
          "id": "inpaas.forms",
          "name": "Forms",
          "icon": "media/inpaas.svg"
        },
        {
          "id": "inpaas.sources",
          "name": "Sources",
          "icon": "media/inpaas.svg"
        },
        {
          "id": "inpaas.entities",
          "name": "Entity",
          "icon": "media/inpaas.svg"
        },
        {
          "id": "inpaas.database",
          "name": "Database",
          "icon": "media/inpaas.svg"
        },
        {
          "id": "inpaas.studio",
          "name": "Studio",
          "icon": "media/inpaas.svg"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "inpaas.openEntityEditor",
          "when": "resourceScheme == file && resourceFilename =~ /.+\\.entity\\.json$/",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.openFormEditor",
          "when": "resourceScheme == file && resourcePath =~ /forms/ && resourceFilename != 'forms' && resourceFilename != 'forms-vue'",
          "group": "inpaas@1"
        },
        {
          "command": "inpaas.openSourceEditor",
          "when": "resourceScheme == file && resourcePath =~ /source/ && resourceFilename != 'source' && resourceFilename != 'sources'",
          "group": "inpaas@1"
        },
        {
          "command": "inpaas.createEntity",
          "when": "explorerResourceIsFolder && resourceScheme == file && resourceFilename == entities",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.createForm",
          "when": "explorerResourceIsFolder && resourceScheme == file && resourceFilename =~ /^(forms|forms-vue)$/",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.createSource",
          "when": "explorerResourceIsFolder && resourceScheme == file && resourceFilename =~ /^(source|sources)$/",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.downloadEntity",
          "when": "resourceScheme == file && resourceFilename =~ /.+\\.entity\\.json$/",
          "group": "inpaas@2"
        },
        {
          "command": "inpaas.copyKey",
          "when": "resourceScheme == file && resourcePath =~ /forms|source|entities/ && resourceFilename != 'forms' && resourceFilename != 'forms-vue' && resourceFilename != 'source' && resourceFilename != 'sources'",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.copyKey",
          "when": "resourceScheme == file && resourcePath =~ /modules/",
          "group": "inpaas@0"
        },
        {
          "command": "inpaas.openModuleSettings",
          "when": "resourceScheme == file && resourcePath =~ /modules/",
          "group": "inpaas@1"
        },
        {
          "command": "inpaas.publishEntity",
          "when": "resourceScheme == file && resourceFilename =~ /.+\\.entity\\.json$/",
          "group": "inpaas@3"
        },
        {
          "command": "inpaas.downloadSourceResource",
          "when": "resourceScheme == file && resourcePath =~ /source/ && resourceFilename != 'source' && resourceFilename != 'sources'",
          "group": "inpaas@2"
        },
        {
          "command": "inpaas.publishSourceResource",
          "when": "resourceScheme == file && resourcePath =~ /source/ && resourceFilename != 'source' && resourceFilename != 'sources'",
          "group": "inpaas@3"
        },
        {
          "command": "inpaas.downloadFormResource",
          "when": "resourceScheme == file && resourcePath =~ /forms/ && resourceFilename != 'forms' && resourceFilename != 'forms-vue'",
          "group": "inpaas@2"
        },
        {
          "command": "inpaas.downloadModule",
          "when": "resourceScheme == file && resourcePath =~ /modules/",
          "group": "inpaas@2"
        },
        {
          "command": "inpaas.publishFormResource",
          "when": "resourceScheme == file && resourcePath =~ /forms/ && resourceFilename != 'forms' && resourceFilename != 'forms-vue'",
          "group": "inpaas@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "inpaas.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "inpaas.executeQuery",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "inpaas.formatSql",
        "key": "shift+alt+f",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "inPaaS",
      "properties": {
        "inpaas.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "URL do servidor local da integração inPaaS."
        },
        "inpaas.studioPath": {
          "type": "string",
          "default": "/forms/inpaas.devstudio.forms.studio/",
          "description": "Caminho do form do Studio aberto dentro do VS Code."
        },
        "inpaas.sourceDownloadPath": {
          "type": "string",
          "default": "/__platform/source",
          "description": "Endpoint local usado para baixar um source."
        },
        "inpaas.formDownloadPath": {
          "type": "string",
          "default": "/__platform/form",
          "description": "Endpoint local usado para baixar um form."
        },
        "inpaas.publishPath": {
          "type": "string",
          "default": "/__platform/publish",
          "description": "Endpoint local usado para publicar manualmente um source ou form."
        },
        "inpaas.entityDirectory": {
          "type": "string",
          "default": "entities",
          "description": "Pasta de entities relativa à raiz do workspace."
        },
        "inpaas.sourceDirectory": {
          "type": "string",
          "default": "source",
          "description": "Pasta de sources relativa à raiz do workspace."
        },
        "inpaas.databaseQueryPath": {
          "type": "string",
          "default": "/api/studio/dbexplorer/v2/run",
          "description": "Endpoint usado para executar queries paginadas."
        },
        "inpaas.databaseMetadataPath": {
          "type": "string",
          "default": "/api/eai-services/DatabaseExplorerUtils/getTablesHint",
          "description": "Endpoint usado para carregar tabelas e colunas do autocomplete SQL."
        }
      }
    }
  }
}
